{
	"name": "n8n-nodes-zabbix",
	"version": "0.1.0",
	"description": "n8n community nodes for the Zabbix JSON-RPC API — 60 resources, 223 operations, plus a new-problem/event trigger",
	"license": "MIT",
	"homepage": "https://github.com/opastorello/n8n-nodes-zabbix#readme",
	"bugs": {
		"url": "https://github.com/opastorello/n8n-nodes-zabbix/issues"
	},
	"keywords": [
		"n8n-community-node-package",
		"zabbix",
		"zabbix-api",
		"monitoring",
		"observability",
		"alerting",
		"snmp",
		"noc",
		"n8n"
	],
	"author": {
		"name": "Nicolas Pastorello",
		"email": "opastorello1@gmail.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/opastorello/n8n-nodes-zabbix.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease",
		"test:smoke": "node test/smoke.js",
		"test:e2e": "node test/e2e.js"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/ZabbixTokenApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Zabbix/Zabbix.node.js",
			"dist/nodes/Zabbix/ZabbixTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.29.0",
		"n8n-workflow": "^2.16.0",
		"prettier": "3.8.3",
		"release-it": "20.2.0",
		"typescript": "6.0.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
