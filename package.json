{
	"name": "n8n-nodes-zabbix",
	"version": "0.2.0",
	"description": "n8n community nodes for the Zabbix API (7.x/8.0) — 60 resources, NOC triage operations, polling and webhook triggers",
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	},
	"homepage": "https://github.com/opastorello/n8n-nodes-zabbix#readme",
	"bugs": {
		"url": "https://github.com/opastorello/n8n-nodes-zabbix/issues"
	},
	"keywords": [
		"n8n-community-node-package",
		"zabbix",
		"zabbix-api",
		"monitoring",
		"observability",
		"alerting",
		"snmp",
		"noc",
		"n8n"
	],
	"author": {
		"name": "Nicolas Pastorello",
		"email": "opastorello1@gmail.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/opastorello/n8n-nodes-zabbix.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease",
		"test:smoke": "node test/smoke.js",
		"test:e2e": "node test/e2e.js",
		"test:e2e:full": "node test/e2e-full.js",
		"test:e2e:trigger": "node test/e2e-trigger.js",
		"test:e2e:compat": "node test/e2e-compat.js",
		"test:token": "node test/create-token.js",
		"test:e2e:noc": "node test/e2e-noc.js"
	},
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=22"
	},
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/ZabbixTokenApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Zabbix/Zabbix.node.js",
			"dist/nodes/Zabbix/ZabbixTrigger.node.js",
			"dist/nodes/Zabbix/ZabbixWebhookTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.46.3",
		"eslint": "9.29.0",
		"n8n-workflow": "^2.37.3",
		"prettier": "3.9.6",
		"release-it": "20.2.1",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
