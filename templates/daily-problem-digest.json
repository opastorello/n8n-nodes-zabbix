{
  "name": "[Zabbix] Daily problem digest",
  "nodes": [
    {
      "id": "a1",
      "name": "Every day 08:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "a2",
      "name": "Zabbix: Get problems",
      "type": "n8n-nodes-zabbix.zabbix",
      "typeVersion": 1,
      "position": [
        260,
        0
      ],
      "parameters": {
        "resource": "problem",
        "operation": "getAll",
        "options": {
          "limit": 100
        }
      },
      "credentials": {
        "zabbixTokenApi": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID",
          "name": "Zabbix account"
        }
      }
    },
    {
      "id": "a3",
      "name": "Build digest",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        0
      ],
      "parameters": {
        "jsCode": "const sev=['Not classified','Information','Warning','Average','High','Disaster'];\nconst problems=items.map(i=>i.json);\nconst bySev={};\nfor(const p of problems){const s=sev[Number(p.severity)]||p.severity;bySev[s]=(bySev[s]||0)+1;}\nconst lines=problems.slice(0,20).map(p=>`- [${sev[Number(p.severity)]}] ${p.name}`);\nreturn [{json:{total:problems.length,bySeverity:bySev,summary:`${problems.length} open problems\n`+lines.join('\n')}}];"
      }
    }
  ],
  "connections": {
    "Every day 08:00": {
      "main": [
        [
          {
            "node": "Zabbix: Get problems",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Zabbix: Get problems": {
      "main": [
        [
          {
            "node": "Build digest",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": false,
  "pinData": {}
}